{
  "compilerOptions": {
      "skipLibCheck": true,
      "lib": ["ES2021"],
      "target": "ES2021",
      "module": "commonjs",
      "moduleResolution": "node",
      "outDir": "./dist",
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "sourceMap": true,
      "sourceRoot": "/",
      "baseUrl": "./",
      "rootDir": "./src",
      "paths": {
         "/*": [
            "./src/*"
         ]
      },
      "types": ["node",  "express"]
   },
   "include": [
      "src/**/*"
   ],
   "exclude": [
      "node_modules",  "dist",
   ]
}
